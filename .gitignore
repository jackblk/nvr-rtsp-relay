tmp/
.env
# Dahua NetSDK — proprietary, not redistributable. Ignore the SDK files and the .whl,
# but keep the setup instructions + script tracked (see NetSDK/README.md).
NetSDK/*
!NetSDK/README.md
!NetSDK/setup.sh
# Hikvision HCNetSDK — proprietary, not redistributable. Ignore the SDK files and
# the zip, but keep the setup instructions + script tracked (see hcnetsdk/README.md).
hcnetsdk/*
!hcnetsdk/README.md
!hcnetsdk/setup.sh
__pycache__/
*.pyc
streams.txt
streams.yml
*.dhav
# Runtime config dir: keep the README, ignore generated files (see config/.gitignore).
tests/fixtures/*.dhav
!tests/fixtures/.gitkeep
.venv/
auto.crt
auto.key
